  "narrative": {
    "northStar": "The Steady Partner",
    "overview": "The system behaves like the company it sells: calm, plain-spoken and dependable. Surfaces alternate between warm paper and deep graphite, type is one bold sans, and nothing decorates for its own sake.\n\nColor is held back so that one gesture can carry meaning: the pink point where a boomerang returns. Motion explains and always has a static end state.",
    "keyCharacteristics": [
      "Paper and graphite bands, white cards, no gradients.",
      "One bold sans (Montserrat) at tight negative tracking for headings.",
      "Pink is the single action and arrival color; teal and aqua carry structure.",
      "Flat, tonal depth; instructive motion only."
    ],
    "rules": [
      {
        "name": "The One Landing Rule",
        "body": "Pink marks action or arrival, and appears a few times per screen at most.",
        "section": "colors"
      },
      {
        "name": "The Paired Accent Rule",
        "body": "Teal on paper, aqua on graphite. Never swap them.",
        "section": "colors"
      },
      {
        "name": "The Tight Heading Rule",
        "body": "Large headings take negative letter-spacing and a line height near 1. Body text never does.",
        "section": "typography"
      },
      {
        "name": "The Tonal Depth Rule",
        "body": "Layer by changing surface color, not by adding shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use pink only for the primary action and for arrival moments.",
      "Do use teal on paper and aqua on graphite for eyebrows, links and focus.",
      "Do build depth with surface tone and hairlines.",
      "Do give every animation a static end state under prefers-reduced-motion."
    ],
    "donts": [
      "Don't add gradients, glows or colored shadows.",
      "Don't introduce a second typeface.",
      "Don't use client logos, testimonials or metrics as visual filler.",
      "Don't use pink at small sizes on paper for text; use deep pink."
    ]
  }
